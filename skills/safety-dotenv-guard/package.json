{
  "name": "@zcaceres/skill-safety-dotenv-guard",
  "version": "2.1.0",
  "description": "Claude Code and Codex PreToolUse hook that blocks file and shell calls that touch .env files (allows .env.example / .env.sample / .env.template / .env.dist).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/index.ts",
    "test": "bun test",
    "build:linux": "bun build scripts/index.ts --compile --target=bun-linux-x64 --outfile scripts/bin/safety-dotenv-guard-linux-x64",
    "build:macos": "bun build scripts/index.ts --compile --target=bun-darwin-arm64 --outfile scripts/bin/safety-dotenv-guard-darwin-arm64",
    "build:windows": "bun build scripts/index.ts --compile --target=bun-windows-x64 --outfile scripts/bin/safety-dotenv-guard-windows-x64.exe",
    "build:all": "bun run build:linux && bun run build:macos && bun run build:windows",
    "fetch-tools": "bun run build:all"
  },
  "files": [
    "SKILL.md",
    "scripts",
    "references",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "skill",
    "hook",
    "safety",
    "secrets",
    "dotenv",
    "pretooluse"
  ]
}
